# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning, an https APP_URL,
# SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true, Redis for cache/session/queue,
# and TURNSTILE_* keys if guest requests or registration are open.
APP_NAME=KiteDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Interface language for the whole installation: en or pt_BR
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Load balancer / reverse proxy addresses (comma separated) or * (see config/trustedproxy.php)
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Let people without an account submit requests (they follow them via emailed links)
KITEDESK_GUEST_TICKETS=true

# Inbound email: servers whose Authentication-Results header is trusted (e.g. mx.google.com;
# empty = the topmost one), and how many To/Cc addresses of a new email get copied on the ticket
KITEDESK_MAIL_AUTHSERV_IDS=
KITEDESK_MAIL_MAX_COPIED_PEOPLE=10

# Allow webhooks and IMAP mailboxes on private/intranet addresses (blocked by default)
KITEDESK_WEBHOOKS_ALLOW_PRIVATE=false

# Key that encrypts secrets exchanged with customers, kept apart from APP_KEY so it can be
# stored and rotated separately. Generate one with: echo "base64:$(openssl rand -base64 32)"
# Empty = derived from APP_KEY (changing APP_KEY then makes stored secrets unreadable).
KITEDESK_SECRETS_KEY=

# OAuth keys for MCP clients (Claude, ChatGPT…). Generate with `php artisan passport:keys`
# (stored in storage/), or paste the PEM contents here in production.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Cloudflare Turnstile CAPTCHA for public forms (leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SCOUT_DRIVER=database
